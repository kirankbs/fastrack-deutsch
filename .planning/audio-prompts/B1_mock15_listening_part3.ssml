      Ohne Premium ist es kaum erträglich.
    </prosody>
  </voice>
  <voice name="de-DE-Wavenet-C">
    <prosody rate="medium">
      Und deine Freunde sind auch kaum dort, oder?
    </prosody>
  </voice>
  <voice name="de-DE-Wavenet-D">
    <prosody rate="medium">
